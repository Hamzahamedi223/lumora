# Copy to .env.local (development) and fill in. Never commit real values.

# Public URL of the site (used in emails, sitemap, metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL. Local: run `npm run dev:db`. Production (Supabase): pooled URL in DATABASE_URL, direct URL in DIRECT_URL.
DATABASE_URL=postgresql://lumora:lumora_dev@localhost:5434/lumora
DIRECT_URL=postgresql://lumora:lumora_dev@localhost:5434/lumora

# First admin account, created by `npm run db:seed`
ADMIN_EMAIL=admin@lumora.tn
ADMIN_PASSWORD=change-me-now

# File storage: "local" (./storage, development) or "supabase"
STORAGE_DRIVER=local
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLIC_BUCKET=public-assets
SUPABASE_PRIVATE_BUCKET=private-files

# Email via Resend (optional; without a key, emails are printed to the server log)
RESEND_API_KEY=
EMAIL_FROM=Lumora <commandes@lumora.tn>
OWNER_EMAIL=

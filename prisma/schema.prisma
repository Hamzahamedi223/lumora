generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// All money amounts are stored in millimes (1 TND = 1000 millimes) as integers.

enum Role {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  BANK_TRANSFER
  D17
}

enum CouponType {
  PERCENT
  FIXED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RequestType {
  LAMP
  WALL_ART
  OTHER
}

enum RequestStatus {
  NEW
  REVIEWING
  QUOTED
  ACCEPTED
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

enum StockReason {
  ADJUSTMENT
  ORDER
  CANCEL_RESTOCK
  RETURN_RESTOCK
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String
  phone       String?
  passwordHash String
  role        Role         @default(CUSTOMER)
  status      UserStatus   @default(ACTIVE)
  lastLoginAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  sessions    Session[]
  resets      PasswordReset[]
  orders      Order[]
  requests    CustomRequest[]
  reviews     Review[]

  @@index([createdAt])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model PasswordReset {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_resets")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model Product {
  id             String         @id @default(cuid())
  slug           String         @unique
  name           String
  tagline        String?
  description    String
  categoryId     String?
  category       Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  priceMinor     Int
  compareAtMinor Int?
  status         ProductStatus  @default(DRAFT)
  featured       Boolean        @default(false)
  isNew          Boolean        @default(false)
  madeToOrder    Boolean        @default(false)
  leadTimeDays   Int?
  material       String?
  dimensions     String?
  bulb           String?
  weight         String?
  salesCount     Int            @default(0)
  images         ProductImage[]
  variants       Variant[]
  reviews        Review[]
  orderItems     OrderItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, categoryId])
  @@index([status, featured])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model Variant {
  id         String          @id @default(cuid())
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  colorHex   String?
  sku        String?         @unique
  stock      Int             @default(0)
  sortOrder  Int             @default(0)
  isActive   Boolean         @default(true)
  orderItems OrderItem[]
  movements  StockMovement[]

  @@index([productId])
  @@map("variants")
}

model StockMovement {
  id        String      @id @default(cuid())
  variantId String
  variant   Variant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  delta     Int
  reason    StockReason
  note      String?
  createdAt DateTime    @default(now())

  @@index([variantId, createdAt])
  @@map("stock_movements")
}

model Review {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  rating    Int
  body      String
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())

  @@index([productId, status])
  @@map("reviews")
}

model Order {
  id             String        @id @default(cuid())
  number         String        @unique
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  status         OrderStatus   @default(PENDING)
  paymentStatus  PaymentStatus @default(UNPAID)
  paymentMethod  PaymentMethod
  customerName   String
  customerEmail  String
  customerPhone  String
  governorate    String
  city           String
  addressLine    String
  postalCode     String?
  notes          String?
  subtotalMinor  Int
  discountMinor  Int           @default(0)
  shippingMinor  Int
  totalMinor     Int
  couponCode     String?
  trackingToken  String
  trackingNumber String?
  adminNote      String?
  items          OrderItem[]
  events         OrderEvent[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([userId])
  @@index([customerEmail])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId      String?
  variant        Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  name           String
  variantName    String?
  image          String?
  unitPriceMinor Int
  quantity       Int
  lineTotalMinor Int
  madeToOrder    Boolean  @default(false)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderEvent {
  id        String       @id @default(cuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus?
  note      String
  actor     String?
  createdAt DateTime     @default(now())

  @@index([orderId, createdAt])
  @@map("order_events")
}

model Coupon {
  id               String     @id @default(cuid())
  code             String     @unique
  type             CouponType
  value            Int // percent (1-100) or millimes
  minSubtotalMinor Int        @default(0)
  maxUses          Int?
  usedCount        Int        @default(0)
  startsAt         DateTime?
  endsAt           DateTime?
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())

  @@map("coupons")
}

model CustomRequest {
  id          String              @id @default(cuid())
  number      String              @unique
  userId      String?
  user        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String
  email       String
  phone       String
  type        RequestType
  description String
  dimensions  String?
  colors      String?
  budget      String?
  deadline    String?
  status      RequestStatus       @default(NEW)
  quoteMinor  Int?
  adminNote   String?
  files       CustomRequestFile[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@map("custom_requests")
}

model CustomRequestFile {
  id        String        @id @default(cuid())
  requestId String
  request   CustomRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  key       String
  name      String
  size      Int
  mime      String

  @@map("custom_request_files")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
  @@map("contact_messages")
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("subscribers")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}
